---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const { remarkPluginFrontmatter } = await entry.render();
---

<a
	href={url}
	class:list={[
		"post-card card-base group relative flex w-full overflow-hidden rounded-[var(--radius-large)]",
		className,
	]}
	style={style}
>
	{hasCover && (
		<div class="relative hidden w-[36%] shrink-0 overflow-hidden md:block">
			<ImageWrapper
				src={image}
				basePath={path.join("content/posts/", getDir(entry.id))}
				alt=""
				class="h-full w-full transition duration-700 group-hover:scale-[1.03]"
			/>
		</div>
	)}

	<div class="flex min-w-0 flex-1 flex-col justify-center px-5 py-4 md:pr-12 md:pl-6">
		<!-- meta: 日期 · 分类 · 字数 -->
		<div class="mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-50">
			<span class="flex items-center gap-1">
				<Icon name="material-symbols:calendar-today-outline-rounded" class="text-[0.9rem]"></Icon>
				{formatDateToYYYYMMDD(published)}
			</span>
			<span class="h-2.5 w-px bg-[var(--line-divider)]"></span>
			<span class="font-medium text-[var(--primary)]">{category || i18n(I18nKey.uncategorized)}</span>
			<span class="h-2.5 w-px bg-[var(--line-divider)]"></span>
			<span>
				{remarkPluginFrontmatter.words}
				{i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
			</span>
		</div>

		<!-- 标题 -->
		<h2 class="mb-1.5 line-clamp-1 text-lg font-bold leading-snug text-90 transition group-hover:text-[var(--primary)] md:text-[1.3rem]">
			{title}
		</h2>

		<!-- 摘要 -->
		<p class="line-clamp-1 text-sm text-75">
			{description || remarkPluginFrontmatter.excerpt}
		</p>
	</div>

	<!-- hover 箭头 -->
	<div class="pointer-events-none absolute right-4 top-1/2 hidden -translate-y-1/2 opacity-0 transition group-hover:opacity-100 md:block">
		<Icon name="material-symbols:chevron-right-rounded" class="text-[1.9rem] text-[var(--primary)]"></Icon>
	</div>
</a>

<style>
	.post-card {
		transition:
			box-shadow 0.25s ease,
			transform 0.25s ease,
			border-color 0.25s ease;
	}

	.post-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 28px -18px rgb(0 0 0 / 0.28);
	}

	:global(.dark) .post-card:hover {
		box-shadow: 0 10px 28px -18px rgb(0 0 0 / 0.7);
	}
</style>
